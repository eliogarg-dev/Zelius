{
  "name": "zapp",
  "version": "0.1.0",
  "description": "Paroliere tra amici: app Android e versione browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "dizionario": "node --max-old-space-size=6000 scripts/prepara-dizionario.ts",
    "emulatori": "node scripts/firebase.mjs emulators:start --project demo-zapp",
    "test:regole": "node scripts/firebase.mjs emulators:exec --only database --project demo-zapp \"vitest run --config vitest.regole.config.ts\"",
    "dev:emulatore": "vite --mode emulatore --host"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliogarg-dev/Zapp.git"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "firebase-tools": "^15.34.1",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "firebase": "^13.1.0",
    "qrcode-generator": "^1.5.2"
  }
}
